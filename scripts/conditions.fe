;; Conditions: handlers receive the constructed condition, hierarchy matching
;; is transitive, a running handler is bypassed, and cleanup errors replace.
(assert-equals '(error "boom")
  (condition-case e (error "boom") (error e)))
(assert-equals '(arith-error 7)
  (condition-case e (signal 'arith-error '(7)) (arith-error e)))
(assert-equals 'caught
  (condition-case nil (car 5) (error 'caught)))
(assert-equals '(wrong-type-argument listp 5)
  (condition-case e (car 5) (wrong-type-argument e)))
(assert-equals '(wrong-type-argument symbolp 5)
  (condition-case e (fboundp 5) (wrong-type-argument e)))
(assert-equals 'quit
  (condition-case nil (signal 'quit nil) (quit 'quit)))
(assert-equals 'multi
  (condition-case nil (/ 1 0) ((wrong-type-argument arith-error) 'multi)))
(assert-equals 'caught-no-catch
  (condition-case nil (throw 'nowhere 1) (error 'caught-no-catch)))
(assert-equals '(error "value 7")
  (condition-case e (error "value %d" 7) (error e)))
(assert-equals '(error "cleanup")
  (condition-case e (unwind-protect (error "orig") (error "cleanup")) (error e)))
(assert-equals 'outer
  (condition-case nil
    (condition-case nil (error "body") (error (error "handler")))
    (error 'outer)))
;; `%s` is Emacs' `princ` and `%S` its `prin1`, all the way down: a string
;; keeps its quotes under `%S` and loses them under `%s`, at the top level
;; and inside a list alike (measured against Emacs 31.0.90).
(assert-equals '(error "% text \"text\"")
  (condition-case e (error "%% %s %S" "text" "text") (error e)))
(assert-equals '(error "(1 x)")
  (condition-case e (error "%s" (list 1 "x")) (error e)))
(assert-equals '(error "(1 \"x\")")
  (condition-case e (error "%S" (list 1 "x")) (error e)))
;; Arguments the format string never consumes are ignored.
(assert-equals '(error "x")
  (condition-case e (error "x" 1 2) (error e)))
;; `(error)` with no format string is a wrong-number-of-arguments condition.
(assert-equals 'wna
  (condition-case nil (error) (wrong-number-of-arguments 'wna)))
(assert-equals 'format-error
  (condition-case nil (error "%") (error 'format-error)))
(assert-equals 'format-error
  (condition-case nil (error "%x" 1) (error 'format-error)))

;; `file-missing` under `file-error` under `error` (sub-plan 12C Part 1) --
;; the first two-deep chain in the hierarchy, and the one Emacs uses for a
;; file that is not there. Every expectation is the answer measured from
;; Emacs 31.0.90 on 2026-08-07; there `(get 'file-missing 'error-conditions)`
;; is `(file-missing file-error error)`.
(assert-equals '(file-missing "Cannot open load file" "No such file or directory" "/x.el")
  (condition-case e
    (signal 'file-missing
      '("Cannot open load file" "No such file or directory" "/x.el"))
    (file-missing e)))
;; Caught through each level of the chain, with the condition object intact.
(assert-equals '(FE (file-missing "a" "b" "/x"))
  (condition-case e (signal 'file-missing '("a" "b" "/x")) (file-error (list 'FE e))))
(assert-equals '(E (file-missing "a" "b" "/x"))
  (condition-case e (signal 'file-missing '("a" "b" "/x")) (error (list 'E e))))
;; And not by an unrelated class.
(assert-equals '(E file-missing)
  (condition-case e (signal 'file-missing '("a"))
    (arith-error 'A)
    (error (list 'E (car e)))))
;; Handler order decides between two matching clauses, both ways round.
(assert-equals 'MISSING
  (condition-case nil (signal 'file-missing '("a")) (file-missing 'MISSING) (file-error 'FE)))
(assert-equals 'FE
  (condition-case nil (signal 'file-missing '("a")) (file-error 'FE) (file-missing 'MISSING)))
;; The chain runs one way only: a `file-error` is not a `file-missing`.
(assert-equals '(E file-error)
  (condition-case e (signal 'file-error '("x")) (file-missing 'M) (error (list 'E (car e)))))
;; Data is optional, as it is for every other class.
(assert-equals '(file-missing)
  (condition-case e (signal 'file-missing nil) (file-error e)))
;; `file-error` itself is unmoved by the addition.
(assert-equals '(file-error "x")
  (condition-case e (signal 'file-error '("x")) (file-error e)))

;; Phase 20: `end-of-buffer` and `beginning-of-buffer`, the two edges an
;; editor's motion commands reach constantly.  Emacs' chain, measured on
;; 31.0.90: `(get 'end-of-buffer 'error-conditions)` is `(end-of-buffer
;; error)`, so `error` catches one and the two do not catch each other.
(assert-equals '(end-of-buffer)
  (condition-case e (signal 'end-of-buffer nil) (error e)))
(assert-equals '(beginning-of-buffer)
  (condition-case e (signal 'beginning-of-buffer nil) (error e)))
(assert-equals 'EOB
  (condition-case nil (signal 'end-of-buffer nil)
    (beginning-of-buffer 'BOB) (end-of-buffer 'EOB)))
(assert-equals '(E beginning-of-buffer)
  (condition-case e (signal 'beginning-of-buffer nil)
    (end-of-buffer 'EOB) (error (list 'E (car e)))))
;; Their rendered text is Emacs' own, from the `error-message` property.
(assert-equals "End of buffer" (error-message-string '(end-of-buffer)))
(assert-equals "Beginning of buffer"
               (error-message-string '(beginning-of-buffer)))
(assert-equals "End of buffer" (get 'end-of-buffer 'error-message))

;; The uncaught tail: everything above is caught, so nothing above this line
;; reaches the host. This one does, and the golden `tests/conditions.fe.err`
;; is what an uncaught condition looks like on its way out of the standalone
;; interpreter -- the rendered message and the call trace, innermost first.
(print "conditions: all caught cases passed")
(condition-case nil (car 5) (arith-error 'not-this-handler))
