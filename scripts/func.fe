(= id (fn (x)
    x))

(assert-is 5 (id 5))
(assert-is (id 5) (id (+ 4 1)))
(assert-equals '(1 2 3 4) (id '(1 2 3 4)))

(= all (fn (xs &optional predicate)
    (if (not predicate)
        (= predicate id))
    (let r t)
    (while xs
        (if (not (predicate (car xs)))
            (= r nil))
        (= xs (cdr xs)))
    r))

(assert-equals '(1 2 3 4) (all '(1 2 3 4)))

(= is-even (fn (x)
    (is 0 (% x 2))))

(assert (is-even 4))
(assert (is-even 2))
(assert (is-even 0))
(assert-nil (is-even 3))
(assert-nil (is-even 1))

(assert (all '(2 4 6 8) is-even))
(assert-nil (all '(2 4 6 7) is-even))

(= any (fn (xs &optional predicate)
    (if (not predicate)
        (= predicate id))
    (let r nil)
    (while xs
        (if (predicate (car xs))
            (= r t))
        (= xs (cdr xs)))
    r))

(assert (any '(1 2 3 4)))
(assert (any '(1 2 3 4) is-even))
(assert-nil (any '(3 5 7 9) is-even))
(assert-nil (any '(nil nil nil)))
(assert (any '(nil nil nil 4)))

;; TODO: filter, map

;; Parameter lists. A parameter with no argument is nil; `&optional` says so
;; out loud. Three spellings collect the rest: a dotted tail, a bare symbol,
;; and `&rest`.

(assert-equals '(1 nil) ((fn (a &optional b) (list a b)) 1))
(assert-equals '(1 2) ((fn (a &optional b) (list a b)) 1 2))
(assert-equals '(1 nil nil) ((fn (a &optional b c) (list a b c)) 1))

(assert-equals '(1 (2 3)) ((fn (a . r) (list a r)) 1 2 3))
(assert-equals '(1 2 3) ((fn r r) 1 2 3))
(assert-equals '(1 (2 3)) ((fn (a &rest r) (list a r)) 1 2 3))
(assert-equals '(1 nil) ((fn (a &rest r) (list a r)) 1))
(assert-equals '(1 2 3) ((fn (&rest r) r) 1 2 3))
(assert-equals '(1 (2 3)) ((fn (a &optional b &rest r) (list a (cons b r))) 1 2 3))

;; Macros take their parameters the same way.
(= rest-macro (macro (a &rest r) (cons 'list (cons a r))))
(assert-equals '(1 2 3) (rest-macro 1 2 3))
