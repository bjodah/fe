;; Sub-plan 09B: an exhausted arena signals a condition like any other one.
;; `(error ...)` catches it, so does the name the hierarchy already reserves
;; for it, and the object the handler is given says which exhaustion it was.
;; Before 09B every one of these forms escaped except the `(t ...)` case: the
;; raise could not allocate the condition object, so it signalled nil and the
;; matcher answered false for every named handler.
;;
;; The chain is a `let`-local in every case here, so it is unreachable the
;; instant the handler's frame is entered and the handler is free to allocate
;; -- which is what lets these forms return a value at all. The default 1 MiB
;; arena makes each round about 56 000 conses; a small `-s` gets the same
;; answers sooner:
;;
;;   ./fe -s 70000 scripts/assert.fe scripts/exhaustion.fe
(assert-equals 'caught
  (condition-case nil
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error 'caught)))
(assert-equals 'by-name
  (condition-case nil
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (arena-exhaustion 'by-name)))
(assert-equals '(arena-exhaustion)
  (condition-case e
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error e)))
(assert-equals 'caught-t
  (condition-case nil
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (t 'caught-t)))

;; The conditions are shared objects for the life of the context, and a
;; handler is handed the object itself rather than a copy. Every raise
;; therefore re-stamps the object before publishing it -- two stores, no
;; allocation, so it is still safe on the path where allocation has already
;; failed. Without that, `(setcar e ...)` in one handler permanently disabled
;; the whole mechanism: measured, the next out-of-memory then escaped both
;; `(error ...)` and `(arena-exhaustion ...)`.
(assert-equals 'poisoned
  (condition-case e
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error (setcar e 'poisoned) (car e))))
(assert-equals 'still-by-name
  (condition-case nil
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (arena-exhaustion 'still-by-name)))

;; The `setcdr` half. Data attached by a handler used to reach the *next*,
;; unrelated exhaustion -- which signalled `(arena-exhaustion 9 9 9)` -- and,
;; because the condition is a context-lifetime GC root, kept that list alive
;; for good. `(setcdr e e)` is the same bug with a cycle attached.
(assert-equals 'attached
  (condition-case e
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error (setcdr e (list 9 9 9)) 'attached)))
(assert-equals 'self-referential
  (condition-case e
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error (setcdr e e) 'self-referential)))
(assert-equals '(arena-exhaustion)
  (condition-case e
    (let ((l nil)) (while t (setq l (cons 1 l))))
    (error e)))

;; The uncaught tail, in the same shape `conditions.fe` uses: an unrelated
;; condition name is still not a match, so this one reaches the host and
;; `tests/exhaustion.fe.err` records what an uncaught exhaustion looks like on
;; its way out of the standalone interpreter.
(print "exhaustion: all caught cases passed")
(condition-case nil
  (let ((l nil)) (while t (setq l (cons 1 l))))
  (arith-error 'not-this-handler))
