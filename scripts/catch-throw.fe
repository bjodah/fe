;; `catch`/`throw` (sub-plan 06C), the first non-local exit that stops
;; partway down the frame stack: value delivery to the matching catch,
;; innermost same-tag wins, `eq` tag comparison, the empty-body nil, and
;; `unwind-protect` cleanups running on the throw path innermost first.

;; CT1: a throw delivers its value to the matching catch, which returns it;
;; the trailing form is never evaluated.
(assert-equals 7 (catch 'tag (throw 'tag 7) 99))

;; CT2: the innermost same-tag catch wins -- the outer catch never sees the
;; throw and returns its own trailing value.
(assert-equals 2 (catch 'a (catch 'a (throw 'a 1)) 2))

;; CT5: tag comparison is `eq` -- an equal fixnum matches.
(assert-equals 'hit (catch 5 (throw 5 'hit) 'miss))

;; A catch with an empty body is nil.
(assert-equals nil (catch 'a))

;; CT5: a shared object as the tag matches by identity.
(setq shared-tag (list 1))
(assert-equals 'hit (catch shared-tag (throw shared-tag 'hit) 'miss))

;; Distinct tags select the level: a throw from the inner body to the outer
;; tag skips the inner catch entirely.
(assert-equals 'outer
  (catch 'outer
    (catch 'inner (throw 'outer 'outer) 'inner-miss)
    'outer-miss))

;; CT7/U3: cleanups registered between the catch and the throw run as the
;; throw unwinds, innermost first.
(setq ct-log '())
(assert-equals 'done
  (catch 'tg
    (unwind-protect
      (unwind-protect
        (throw 'tg 'done)
        (setq ct-log (cons 'inner ct-log)))
      (setq ct-log (cons 'outer ct-log)))))
(assert-equals '(outer inner) ct-log)

;; The thrown value is delivered intact even when the abandoned body has
;; allocated since the value was created.
(assert-equals '(111 . 222)
  (catch 'tg
    (do
      (setq ct-gc-i 0)
      (while (< ct-gc-i 2000)
        (cons ct-gc-i ct-gc-i)
        (setq ct-gc-i (+ ct-gc-i 1)))
      (throw 'tg (cons 111 222)))))

;; 06A Decision 4, measured against Emacs 31.0.90: a `throw` raised by an
;; `unwind-protect` cleanup wins over whatever completion was already
;; unwinding -- another throw, an error, or an ordinary return. The catch it
;; names lives below the cleanup's own nested run, so the throw is re-issued
;; in the enclosing context rather than answered where it was raised.
(assert-equals 'b (catch 'tg (unwind-protect (throw 'tg 'a) (throw 'tg 'b))))
(assert-equals 'b (catch 'tg (unwind-protect (error "orig") (throw 'tg 'b))))
(assert-equals 'b (catch 'tg (unwind-protect 1 (throw 'tg 'b))))
(assert-equals 2 (catch 'o (catch 'i (unwind-protect (throw 'i 1) (throw 'o 2)))))

;; Frames being abandoned are still live while the cleanup runs, so the
;; inner catch is still established and takes the cleanup's throw.
(assert-equals 2
  (catch 'o
    (unwind-protect
      (catch 'i (unwind-protect (throw 'o 1) (throw 'i 2)))
      'x)))

;; An enclosing `condition-case` sees the replacing throw's value, not the
;; error the cleanup replaced.
(assert-equals 'b
  (condition-case e
    (catch 'tg (unwind-protect (error "orig") (throw 'tg 'b)))
    (error (list 'err e))))

;; Cleanups between the replacing throw and its catch still run, innermost
;; first, on the new throw's own path.
(setq ct-replace-log '())
(assert-equals 'b
  (catch 'tg
    (unwind-protect
      (unwind-protect (throw 'tg 'a) (throw 'tg 'b))
      (setq ct-replace-log (cons 'outer ct-replace-log)))))
(assert-equals '(outer) ct-replace-log)

;; A cleanup throw with no matching catch anywhere is `no-catch`, which is
;; an ordinary error and catchable as one.
(assert-equals '(no-catch nope 1)
  (condition-case e (unwind-protect (error "orig") (throw 'nope 1)) (error e)))

;; Printed so the golden pins values, not just the absence of a failure.
(print (catch 'tg (throw 'tg 'delivered)))
(print (catch 'tg (unwind-protect (throw 'tg 'a) (throw 'tg 'b))))
(print ct-log)
(print ct-replace-log)

;; The zero-and-wrong-operand degenerates, each caught so the script can
;; carry on. Measured Emacs: (catch) is (wrong-number-of-arguments catch 0),
;; (throw 'x) is wna 1 and (throw 'x 1 2) is wna 3; Fe names the same
;; condition, with no (FUNCTION NARGS) data of its own.
(print (condition-case e (catch) (error (car e))))
(print (condition-case e (throw 'x) (error (car e))))
(print (condition-case e (throw 'x 1 2) (error (car e))))
