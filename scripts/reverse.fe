(setq reverse (fn (lst)
  (let res nil)
  (while lst
    (setq res (cons (car lst) res))
    (setq lst (cdr lst))
  )
  res
))

(setq animals '("cat" "dog" "fox"))

(print (reverse animals)) ; => ("fox" "dog" "cat")
(assert-equals '("fox" "dog" "cat") (reverse animals))
(assert-equals animals animals)
(assert-equals (reverse animals) (reverse animals))
